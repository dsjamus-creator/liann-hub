{
  "name": "liann-hub",
  "private": true,
  "version": "0.1.0",
  "description": "Learning with LiANN hub (app.lwliann.com): static web app, no build step",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/unit.test.mjs tests/protect.test.mjs tests/security.test.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "check": "npm test && npm run test:smoke",
    "deploy": "wrangler deploy --var \"SIGNING_KEY:$(openssl rand -hex 32)\"",
    "deploy:check": "wrangler deploy --dry-run --var SIGNING_KEY:dry-run"
  },
  "devDependencies": {
    "playwright-core": "1.56.1",
    "wrangler": "^4.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}
